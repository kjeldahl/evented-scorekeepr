#!/usr/bin/env sh
set -e

# Notify AppSignal of this deploy so it can be marked on graphs.
# https://docs.appsignal.com/application/markers.html
if [ -n "$APPSIGNAL_PUSH_API_KEY" ]; then
  curl -s -X POST "https://appsignal.com/api/v1/markers" \
    -d "api_key=$APPSIGNAL_PUSH_API_KEY" \
    -d "revision=$KAMAL_VERSION" \
    -d "user=$KAMAL_PERFORMER" \
    -d "environment=production" > /dev/null
fi

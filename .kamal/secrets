# Secrets defined here are available for reference under registry/password,
# env/secret and accessories/*/env/secret in config/deploy.yml. All secrets
# should be pulled from either password manager vaults or from the ENV --
# this file is committed, so never write a literal secret value here.
#
# Values are fetched from 1Password via the 1Password CLI (`op`). Sign in
# once per session: `op signin --account my.1password.com`. The three
# secrets live as fields on a single item; one `fetch` = one op call (and
# one biometric prompt) for all of them.

SECRETS=$(kamal secrets fetch --adapter 1password --account my.1password.com --from Scorekeepr/Scorekeepr KAMAL_REGISTRY_PASSWORD POSTGRES_PASSWORD RAILS_MASTER_KEY)

# Container registry password (e.g. a GitHub PAT with write:packages when
# using ghcr.io).
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)

# Decryption key for config/credentials.yml.enc.
RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY $SECRETS)

# One PostgreSQL password feeds both sides: POSTGRES_PASSWORD initialises
# the db accessory (and authenticates the db-backup accessory), while the
# app reads the same value as EVENT_STORE_PASSWORD (config/event_store.yml).
POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD $SECRETS)
EVENT_STORE_PASSWORD=$POSTGRES_PASSWORD

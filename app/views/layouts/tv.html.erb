<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Scorekeepr" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Scorekeepr">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag :app %>
    <%# The ActionCable client shipped inside the actioncable gem (UMD build
        exposing window.ActionCable) — on the propshaft asset path via the
        engine; no npm, no importmap. %>
    <%= javascript_include_tag "actioncable" %>
  </head>

  <body class="tv">
    <main class="container tv-container">
      <%= yield %>
    </main>
  </body>
</html>

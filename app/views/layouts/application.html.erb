<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Scorekeepr" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Scorekeepr">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <%= link_to "Scorekeepr", root_path, class: "brand" %>
        <nav class="site-nav">
          <% if signed_in? %>
            <%= link_to "Accounts", root_path %>
            <%= link_to current_user.name, profile_path, class: "muted" %>
            <%= button_to "Sign out", "/logout", method: :delete, class: "nav-button" %>
          <% else %>
            <%= link_to "Sign in", login_path %>
            <%= link_to "Sign up", signup_path %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if flash[:notice].present? %>
        <p class="flash flash--notice"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert].present? %>
        <p class="flash flash--alert"><%= flash[:alert] %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>

<% content_for :title, "Sign up — Scorekeepr" %>

<div class="card">
  <h1>Sign up</h1>

  <%= form_with url: signup_path do |form| %>
    <%= form.label :name, "Name" %>
    <%= form.text_field :name, value: params[:name] %>

    <%= form.label :email, "Email" %>
    <%= form.email_field :email, value: params[:email] %>

    <%= form.label :password, "Password" %>
    <%= form.password_field :password %>

    <div class="actions">
      <%= form.submit "Sign up" %>
    </div>
  <% end %>

  <p class="muted">Already have an account? <%= link_to "Sign in", login_path %></p>
</div>

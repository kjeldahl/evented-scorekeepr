<% content_for :title, "My accounts — Scorekeepr" %>

<div class="card">
  <h1>My accounts</h1>

  <% if @accounts.any? %>
    <ul class="account-list">
      <% @accounts.each do |account| %>
        <li><%= link_to account.name, account_path(account.id) %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">You are not a member of any account yet.</p>
  <% end %>

  <div class="actions">
    <%= link_to "New account", new_account_path %>
    <% if @super_admin %>
      <%= link_to "All accounts", accounts_path %>
      <%= link_to "Hand off super admin", new_super_admin_handoff_path %>
    <% end %>
  </div>
</div>

<div class="card">
  <h2>Pending invitations</h2>
  <%= render "pending_invitations/list", pending_invitations: @pending_invitations %>
</div>

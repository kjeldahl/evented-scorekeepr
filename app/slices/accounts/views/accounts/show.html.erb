<% content_for :title, "#{@account.name} — Scorekeepr" %>

<h1><%= @account.name %></h1>

<div class="card">
  <h2>Leagues</h2>
  <%# Leagues are owned by the leagues slice; this section folds its
      LeagueCreated/LeagueClosed events (the cross-slice contract) and links
      each league to its scoreboard page per the routing table. %>
  <% if @leagues.any? %>
    <ul class="league-list">
      <% @leagues.each do |league| %>
        <li>
          <%= link_to league.name, account_league_scoreboard_path(@account.id, league.league_id) %>
          <% unless league.open? %><span class="muted">(closed)</span><% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">No leagues yet.</p>
  <% end %>
  <%# Write affordances are hidden from non-member viewers (super admins);
      enforcement stays in the member gates and command invariants. %>
  <% if @member %>
    <div class="actions">
      <%= link_to "New league", new_account_league_path(@account.id) %>
    </div>
  <% end %>
</div>

<div class="card">
  <h2>Members</h2>
  <table class="members">
    <thead>
      <tr><th>Name</th><% if @super_admin %><th></th><% end %></tr>
    </thead>
    <tbody>
      <% @members.each do |member| %>
        <tr>
          <td><%= member.name %></td>
          <%# A super admin may impersonate any member but themselves
              (docs/DOMAIN.md § Impersonation); ordinary members see no button. %>
          <% if @super_admin %>
            <td class="actions">
              <% unless member.user_id == current_user.id %>
                <%= button_to "Impersonate", impersonate_account_member_path(@account.id, member.user_id) %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @member %>
    <div class="actions">
      <%= link_to "Invite player", new_account_invitation_path(@account.id) %>
      <%= button_to "Leave account", leave_account_path(@account.id) %>
    </div>
  <% end %>
</div>

<div class="card">
  <h2>Outgoing invitations</h2>
  <% if @outgoing_invitations.any? %>
    <ul class="outgoing-invitations">
      <% @outgoing_invitations.each do |invitation| %>
        <li>
          <%= invitation.email %>
          <span class="muted">awaiting acceptance</span>
          <% if @member %>
            <%= button_to "Revoke", revoke_account_invitation_path(@account.id, invitation.invitation_id) %>
            <% if dev_tools? %>
              <%= button_to "Accept on behalf",
                            accept_account_invitation_on_behalf_path(@account.id, invitation.invitation_id) %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">No outgoing invitations.</p>
  <% end %>
</div>

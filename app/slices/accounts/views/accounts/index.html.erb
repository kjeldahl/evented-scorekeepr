<% content_for :title, "All accounts - Scorekeepr" %>

<div class="card">
  <h1>All accounts</h1>

  <table class="all-accounts">
    <thead>
      <tr><th>Account</th></tr>
    </thead>
    <tbody>
      <% @accounts.each do |account| %>
        <tr><td><%= link_to account.name, account_path(account.id) %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>
